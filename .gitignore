# Terraform working directories
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plan output
*.tfplan
plan.txt

# Crash logs
crash.log
crash.*.log

# Sensitive variable files (terraform.tfvars is excluded from this rule)
*.tfvars
!terraform.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend config (contains bucket name)
backend.hcl

# Local CLI config
.terraformrc
terraform.rc

# OS / editor noise
.DS_Store
